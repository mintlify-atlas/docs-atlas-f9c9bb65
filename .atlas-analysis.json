  "keyFeatures": [
    "In-game song downloader with progress tracking and retry support",
    "LR2IR leaderboards and ghost battle support",
    "Built-in mod menu (F5/Insert) with Random Trainer and rate modifiers",
    "Live skin configuration and Skin Widget Manager",
    "OBS WebSocket integration for automated scene switching and recording",
    "Discord webhook support for screenshot sharing and score posting",
    "Automatic per-chart volume normalization",
    "Osu file format support alongside BMS/BMSON",
    "Improved graphics performance via libGDX 1.13 and lwjgl3 backend",
    "Difficulty table management UI with built-in popular table list"
  ],
